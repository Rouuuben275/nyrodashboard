{
  "name": "rpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test --test-isolation=none --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:http": "tsx --test tests/http-flow.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:postgres:http": "node scripts/test-postgres.mjs --http",
    "audit:ui": "node scripts/audit-ui.mjs",
    "db:local": "prisma dev --name rpilot",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed:demo": "tsx scripts/seed.ts",
    "db:migrate:status": "node scripts/migrate-database.mjs status",
    "db:migrate:production": "node scripts/migrate-database.mjs deploy --production",
    "vercel:check": "node scripts/check-vercel-env.mjs",
    "prebuild": "node scripts/check-vercel-env.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/functions": "3.10.3",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfkit": "^0.20.2",
    "pg": "8.20.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.16.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
