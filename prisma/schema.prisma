generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uploadTransfers UploadTransfer[]
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  themePreference String?
  notificationMutedCategories String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessStatus  String @default("ACTIVE")
  suspendedUntil DateTime?
  adminRevision Int @default(0)
  sessions      Session[]
  accounts      Account[]
  characters    RPCharacter[]
  memberships   CompanyMember[]
  servers       ServerMember[]
  notifications Notification[]
  jobApplications JobApplication[]
  communityMemberships ServerCommunityMember[]
  serverAccessRequests ServerAccessRequest[]
  uploadedLogos LogoAsset[]
}

model LogoAsset {
  id String @id @default(uuid())
  ownerId String
  purpose String
  data Bytes
  size Int
  width Int
  height Int
  attachedAt DateTime?
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  companies Company[]
  servers RPServer[]
  @@index([ownerId,createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Better Auth OAuthAccount model, including credentials and Discord accounts.
model Account {
  id                     String   @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}

// Entitlements belong to the verified Discord identity, including before signup.
model CompanySlotAccount {
  discordId String @id
  granted Int @default(0)
  purchased Int @default(0)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySlotPurchase {
  id String @id @default(cuid())
  discordId String
  requestKey String @unique
  status String @default("PENDING")
  mode String
  amount Int @default(500)
  currency String @default("eur")
  sessionId String? @unique
  checkoutUrl String?
  paymentIntentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt DateTime?
  reversedAt DateTime?
  @@index([discordId,createdAt,id])
}

model CompanySlotPaymentEvent {
  id String @id
  type String
  purchaseId String
  createdAt DateTime @default(now())
  @@index([purchaseId,createdAt])
}

model PlatformGrant {
  id String @id @default(cuid())
  discordId String @unique
  permissions String[]
  status String @default("ACTIVE")
  expiresAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServerDiscordGrant {
  id String @id @default(cuid())
  serverId String
  discordId String
  roleId String
  status String @default("ACTIVE")
  expiresAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server RPServer @relation(fields:[serverId],references:[id],onDelete:Cascade)
  role ServerRole @relation(fields:[serverId,roleId],references:[serverId,id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([serverId,discordId])
}

model PlatformAudit {
  id String @id @default(cuid())
  actorId String
  actorName String
  action String
  targetType String
  targetId String
  reason String
  result String @default("SUCCESS")
  correlationId String
  changes Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt,id])
  @@index([targetType,targetId,createdAt])
}

model PlatformCommand {
  id String @id @default(cuid())
  requestKey String @unique
  fingerprint String
  result Json
  createdAt DateTime @default(now())
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model PayrollPolicy {
  id String @id @default(cuid())
  companyId String
  targetKey String
  memberId String?
  roleId String?
  mode String
  rate Int
  regularMinutes Int
  overtimeBps Int
  commissionBps Int
  revision Int @default(0)
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  member CompanyMember? @relation(fields:[companyId,memberId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  role CompanyRole? @relation(fields:[companyId,roleId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([companyId,targetKey])
}

model PayrollRun {
  id String @id @default(cuid())
  companyId String
  label String
  from DateTime @db.Date
  to DateTime @db.Date
  status String @default("OPEN")
  createdBy String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  slips PayrollSlip[]
  @@unique([companyId,id])
  @@index([companyId,from,to])
}

model PayrollSlip {
  id String @id @default(cuid())
  companyId String
  runId String
  memberId String
  status String @default("DRAFT")
  revision Int @default(0)
  employeeName String
  department String
  roleName String
  mode String
  rate Int
  regularMinutes Int
  overtimeBps Int
  commissionBps Int
  workedMinutes Int
  overtimeMinutes Int
  baseAmount Int
  overtimeAmount Int
  salesAmount Int
  commissionAmount Int
  bonus Int
  deduction Int
  total Int
  note String
  sourceHash String
  preparedBy String
  approvedBy String?
  paidBy String?
  paidAt DateTime?
  accountLabel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyRun PayrollRun @relation(fields:[companyId,runId],references:[companyId,id],onDelete:Cascade)
  member CompanyMember @relation(fields:[companyId,memberId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  times PayrollTime[]
  events PayrollEvent[]
  @@unique([companyId,id])
  @@unique([companyId,runId,memberId])
  @@index([companyId,memberId,status])
}

model PayrollTime {
  id String @id @default(cuid())
  companyId String
  slipId String
  entryId String
  reviewId String
  revision Int
  minutes Int
  slip PayrollSlip @relation(fields:[companyId,slipId],references:[companyId,id],onDelete:Cascade)
  @@unique([companyId,slipId,entryId])
  @@index([companyId,entryId])
}

model PayrollEvent {
  id String @id @default(cuid())
  companyId String
  slipId String
  action String
  actorId String
  reason String
  snapshot Json
  createdAt DateTime @default(now())
  slip PayrollSlip @relation(fields:[companyId,slipId],references:[companyId,id],onDelete:Cascade)
  @@index([companyId,slipId,createdAt])
}

model PayrollCommand {
  id String @id @default(cuid())
  companyId String
  requestKey String
  fingerprint String
  result Json
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,requestKey])
}

model HrTemplate {
  id String @id @default(cuid())
  companyId String
  kind String
  name String
  instructions String @default("")
  criteria Json @default("[]")
  archived Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  campaigns HrCampaign[]
  @@unique([companyId,id])
  @@unique([companyId,kind,name])
  @@index([companyId,kind,archived,name])
}

model HrCampaign {
  id String @id @default(cuid())
  companyId String
  templateId String
  name String
  templateName String
  criteria Json
  from DateTime @db.Date
  to DateTime @db.Date
  status String @default("OPEN")
  revision Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  template HrTemplate @relation(fields:[companyId,templateId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  records HrRecord[]
  @@unique([companyId,id])
  @@index([companyId,status,from])
}

model HrRecord {
  id String @id @default(cuid())
  companyId String
  memberId String
  kind String
  campaignId String?
  title String
  templateName String
  employeeName String
  department String
  status String @default("DRAFT")
  revision Int @default(0)
  occurredAt DateTime
  content String
  conclusion String
  privateNote String @default("")
  criteria Json @default("[]")
  goals Json @default("[]")
  scoreBps Int?
  createdBy String
  publishedBy String?
  publishedAt DateTime?
  acknowledgedAt DateTime?
  employeeComment String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  member CompanyMember @relation(fields:[companyId,memberId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  campaign HrCampaign? @relation(fields:[companyId,campaignId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  events HrRecordEvent[]
  @@unique([companyId,id])
  @@unique([companyId,campaignId,memberId])
  @@index([companyId,kind,status,occurredAt])
  @@index([companyId,memberId,kind,publishedAt])
}

model HrRecordEvent {
  id String @id @default(cuid())
  companyId String
  recordId String
  action String
  actorId String
  actorName String
  reason String
  snapshot Json
  createdAt DateTime @default(now())
  record HrRecord @relation(fields:[companyId,recordId],references:[companyId,id],onDelete:Cascade)
  @@index([companyId,recordId,createdAt])
}

model HrCommand {
  id String @id @default(cuid())
  companyId String
  requestKey String
  fingerprint String
  result Json
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,requestKey])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model RPCharacter {
  id        String @id @default(cuid())
  userId    String
  name      String
  phone     String?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model RPServer {
  id          String @id @default(cuid())
  name        String
  description String @default("")
  createdAt   DateTime @default(now())
  slug        String? @unique
  logoUrl     String @default("")
  logoAssetId String? @unique
  logoAsset LogoAsset? @relation(fields:[logoAssetId],references:[id],onDelete:SetNull)
  bannerUrl   String @default("")
  status      String @default("ACTIVE")
  suspendedUntil DateTime?
  visibility  String @default("PRIVATE")
  accessMode  String @default("PRIVATE")
  maxCompanies Int @default(100)
  maxUsers    Int @default(1000)
  revision    Int @default(0)
  discordGrants ServerDiscordGrant[]
  communityMembers ServerCommunityMember[]
  accessRequests ServerAccessRequest[]
  accessEvents ServerAccessEvent[]
  accessCommands ServerAccessCommand[]
  members     ServerMember[]
  roles       ServerRole[]
  companies   Company[]
  auditLogs   ServerAuditLog[]
}

model ServerCommunityMember {
  id String @id @default(cuid())
  serverId String
  userId String
  status String @default("ACTIVE")
  revision Int @default(0)
  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server RPServer @relation(fields:[serverId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([serverId,userId])
  @@index([serverId,status,id])
}

model ServerAccessRequest {
  id String @id @default(cuid())
  serverId String
  userId String
  message String
  status String @default("PENDING")
  decisionReason String @default("")
  revision Int @default(0)
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  server RPServer @relation(fields:[serverId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([serverId,userId])
  @@index([serverId,status,requestedAt,id])
}

model ServerAccessEvent {
  id String @id @default(cuid())
  serverId String
  userId String
  actorId String
  actorName String
  kind String
  reason String
  createdAt DateTime @default(now())
  server RPServer @relation(fields:[serverId],references:[id],onDelete:Cascade)
  @@index([serverId,userId,createdAt,id])
}

model ServerAccessCommand {
  id String @id @default(cuid())
  serverId String
  requestKey String @unique
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  server RPServer @relation(fields:[serverId],references:[id],onDelete:Cascade)
}

model ServerAuditLog {
  id        String @id @default(cuid())
  serverId  String
  actorId   String
  actorName String
  action    String
  entityId  String?
  createdAt DateTime @default(now())
  server    RPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  @@index([serverId, createdAt])
}

model ServerMember {
  id       String @id @default(cuid())
  serverId String
  userId   String
  roleId   String
  status   String @default("ACTIVE")
  expiresAt DateTime?
  server   RPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ServerRole @relation(fields: [serverId, roleId], references: [serverId, id])
  @@unique([serverId, userId])
}

model ServerRole {
  id          String @id @default(cuid())
  serverId    String
  name        String
  permissions String[]
  server      RPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     ServerMember[]
  discordGrants ServerDiscordGrant[]
  @@unique([serverId, id])
}

model Company {
  uploadTransfers UploadTransfer[]
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String @default("")
  sector      String @default("Garage")
  logoUrl String @default("")
  logoAssetId String? @unique
  logoAsset LogoAsset? @relation(fields:[logoAssetId],references:[id],onDelete:SetNull)
  serverId    String?
  currency    String @default("USD")
  expenseThreshold Int @default(100000)
  publicEnabled Boolean @default(false)
  accessStatus String @default("ACTIVE")
  suspendedUntil DateTime?
  adminRevision Int @default(0)
  createdAt   DateTime @default(now())
  server      RPServer? @relation(fields: [serverId], references: [id])
  members     CompanyMember[]
  roles       CompanyRole[]
  modules     CompanyModule[]
  invitations Invitation[]
  departments Department[]
  products    Product[]
  sales       Sale[]
  entries     FinancialEntry[]
  financeAccounts FinanceAccount[]
  financeReconciliations FinanceReconciliation[]
  stockBatches StockBatch[]
  financeCategories FinanceCategory[]
  financeOperations FinanceOperation[]
  expenses    Expense[]
  expenseClaims ExpenseClaim[]
  shifts      Shift[]
  shiftSeries ShiftSeries[]
  availabilities MemberAvailability[]
  leaveTypes LeaveType[]
  scheduleCommands ScheduleCommand[]
  recruitmentJobs RecruitmentJob[]
  recruitmentCommands RecruitmentCommand[]
  timeEntries TimeEntry[]
  leaveRequests LeaveRequest[]
  tasks       Task[]
  taskStatuses TaskStatus[]
  taskCommands TaskCommand[]
  announcements Announcement[]
  announcementCommands AnnouncementCommand[]
  calendarEvents CalendarEvent[]
  calendarSeries CalendarSeries[]
  calendarCommands CalendarCommand[]
  auditLogs   AuditLog[]
  customers   Customer[]
  billingDocuments BillingDocument[]
  suppliers   Supplier[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  stockWarehouses StockWarehouse[]
  documents   Document[]
  documentFolders DocumentFolder[]
  documentCommands DocumentCommand[]
  chatThreads ChatThread[]
  chatCommands ChatCommand[]
  equipmentItems EquipmentItem[]
  utilityCommands UtilityCommand[]
  contracts   Contract[]
  automations Automation[]
  subscription Subscription?
  payrollPolicies PayrollPolicy[]
  payrollRuns PayrollRun[]
  payrollCommands PayrollCommand[]
  hrTemplates HrTemplate[]
  hrCampaigns HrCampaign[]
  hrRecords HrRecord[]
  hrCommands HrCommand[]
}

model CompanyMember {
  equipmentCustody EquipmentItem[]
  statisticsLayout StatisticsLayout?
  chatParticipants ChatParticipant[]
  calendarInvites CalendarInvite[]
  announcementReads AnnouncementRead[]
  assignedTasks Task[] @relation("TaskAssignee")
  id          String @id @default(cuid())
  companyId   String
  userId      String
  roleId      String
  characterName String
  department  String @default("Équipe principale")
  status      String @default("ACTIVE")
  hiredAt     DateTime @default(now())
  salary      Int @default(0)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id])
  role        CompanyRole @relation(fields: [companyId, roleId], references: [companyId, id])
  shifts      Shift[]
  timeEntries TimeEntry[]
  leaves      LeaveRequest[]
  profile     EmployeeProfile?
  career      EmployeeEvent[]
  availabilities MemberAvailability[]
  payrollPolicies PayrollPolicy[]
  payrollSlips PayrollSlip[]
  hrRecords HrRecord[]
  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([companyId, status])
}

model EmployeeProfile {
  id          String @id @default(cuid())
  companyId   String
  memberId    String
  phone       String @default("")
  jobTitle    String @default("")
  biography   String @default("")
  updatedAt   DateTime @updatedAt
  member      CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Cascade)
  @@unique([companyId, memberId])
}

model EmployeeEvent {
  id          String @id @default(cuid())
  companyId   String
  memberId    String
  kind        String
  title       String
  content     String
  actorId     String
  actorName   String
  createdAt   DateTime @default(now())
  member      CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id], onDelete: Cascade)
  @@index([companyId, memberId, createdAt])
}

model Department {
  id        String @id @default(cuid())
  companyId String
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, name])
}

model CompanyRole {
  id          String @id @default(cuid())
  companyId   String
  name        String
  permissions String[]
  isOwner     Boolean @default(false)
  position    Int @default(100)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     CompanyMember[]
  invitations Invitation[]
  payrollPolicies PayrollPolicy[]
  @@unique([companyId, id])
  @@unique([companyId, name])
  @@index([companyId, position])
}

model CompanyModule {
  id        String @id @default(cuid())
  companyId String
  key       String
  enabled   Boolean @default(true)
  settings  Json @default("{}")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, key])
}

model Invitation {
  id        String @id @default(cuid())
  companyId String
  email     String
  roleId    String
  tokenHash String @unique
  status    String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole @relation(fields: [companyId, roleId], references: [companyId, id])
  @@index([email, status])
}

model Shift {
  id        String @id @default(cuid())
  companyId String
  memberId  String
  title     String
  start     DateTime
  end       DateTime
  status String @default("SCHEDULED")
  revision Int @default(0)
  cancelReason String?
  cancelledBy String?
  seriesId String?
  series ShiftSeries? @relation(fields:[companyId,seriesId],references:[companyId,id],onDelete:NoAction,onUpdate:NoAction)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member    CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id])
  @@index([companyId, start])
}

model ShiftSeries {
  id String @id @default(cuid())
  companyId String
  title String
  actorId String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  shifts Shift[]
  @@unique([companyId,id])
}

model RecruitmentJob {
  id String @id @default(cuid())
  companyId String
  title String
  description String
  requirements String @default("")
  location String @default("")
  contractType String @default("OTHER")
  positions Int @default(1)
  status String @default("DRAFT")
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  applications JobApplication[]
  @@unique([companyId,id])
  @@index([companyId,status,createdAt])
}

model JobApplication {
  id String @id @default(cuid())
  companyId String
  jobId String
  userId String
  jobTitle String
  characterName String
  phone String @default("")
  motivation String
  availability String @default("")
  status String @default("SUBMITTED")
  revision Int @default(0)
  interviewAt DateTime?
  interviewDetails String @default("")
  decisionReason String @default("")
  offeredRoleId String?
  offeredRoleName String?
  offeredDepartment String?
  offeredSalary Int?
  offeredBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job RecruitmentJob @relation(fields:[companyId,jobId],references:[companyId,id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id])
  events RecruitmentEvent[]
  @@unique([companyId,id])
  @@unique([jobId,userId])
  @@index([companyId,status,createdAt])
  @@index([userId,createdAt])
}

model RecruitmentEvent {
  id String @id @default(cuid())
  companyId String
  applicationId String
  kind String
  content String
  details Json @default("{}")
  visibleToCandidate Boolean @default(false)
  actorId String
  actorName String
  createdAt DateTime @default(now())
  application JobApplication @relation(fields:[companyId,applicationId],references:[companyId,id],onDelete:Cascade)
  @@index([companyId,applicationId,createdAt])
}

model RecruitmentCommand {
  id String @id @default(cuid())
  companyId String
  requestKey String
  fingerprint String
  resultId String
  revision Int
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,requestKey])
}

model MemberAvailability {
  id String @id @default(cuid())
  companyId String
  memberId String
  start DateTime
  end DateTime
  kind String
  notes String @default("")
  active Boolean @default(true)
  revision Int @default(0)
  cancelReason String?
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  member CompanyMember @relation(fields:[companyId,memberId],references:[companyId,id])
  @@index([companyId,memberId,start])
}

model LeaveType {
  id String @id @default(cuid())
  companyId String
  code String
  name String
  archived Boolean @default(false)
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  leaves LeaveRequest[]
  @@unique([companyId,id])
  @@unique([companyId,code])
}

model ScheduleCommand {
  id String @id @default(cuid())
  companyId String
  requestKey String
  fingerprint String
  resultId String
  revision Int @default(0)
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,requestKey])
}

model TimeEntry {
  id        String @id @default(cuid())
  companyId String
  memberId  String
  start     DateTime @default(now())
  end       DateTime?
  revision Int @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member    CompanyMember @relation(fields: [companyId, memberId], references: [companyId, id])
  pauses TimePause[]
  corrections TimeCorrection[]
  reviews TimeReview[]
  commands TimeCommand[]
  @@unique([companyId,id])
  @@index([companyId, memberId, end])
}

model TimePause {
