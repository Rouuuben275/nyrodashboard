# Safe placeholders only. Configure real secrets directly in Vercel Settings.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
BETTER_AUTH_URL="https://nyrodashboard.vercel.app"
BETTER_AUTH_SECRET="CHANGE_ME_COPY_THE_EXISTING_CLOUDFLARE_AUTH_SECRET"
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="CHANGE_ME_COPY_THE_EXISTING_DISCORD_SECRET"
RPILOT_OWNER_DISCORD_ID="YOUR_EXISTING_OWNER_DISCORD_ID"

# Optional: defaults to the verified production domain above.
SITE_URL="https://nyrodashboard.vercel.app"
RPILOT_SLOT_PAYMENTS_MODE="disabled"

# Optional, test payments only. Leave empty while slot purchases are disabled.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Operator workstation only, not needed by Vercel Functions or the build.
# Must target the SAME EXISTING Neon database as DATABASE_URL.
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
