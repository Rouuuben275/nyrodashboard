RPILOT_SLOT_PAYMENTS_MODE="disabled"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public canonical origin; verified project domain.
SITE_URL="https://nyrodashboard.vercel.app"
# Direct URL is read only by the manual migration helper; same database.
DIRECT_URL=""
